import { mockQuizData } from '../mocks/quizData';

/**
 * Simulates an API network request with a configurable delay.
 * @param {number} ms - The delay time in milliseconds (defaults to 800ms)
 */
const delay = (ms = 900) => new Promise(resolve => setTimeout(resolve, ms));

export const quizService = {
  /**
   * Fetches all available food theme configurations.
   * @returns {Promise<Object>} The themes object map
   */
  async getThemes() {
    await delay(700); // Simulate slightly faster network response for settings
    return mockQuizData.themes;
  },

  /**
   * Fetches the list of quiz questions.
   * @returns {Promise<Array>} Array of question objects
   */
  async getQuestions() {
    await delay(1100); // Simulate network latency for main content
    return mockQuizData.questions;
  },

  /**
   * Fetches the entire initial payload (both themes and questions) in one request.
   * @returns {Promise<Object>} The complete quiz state data payload
   */
  async getInitialData() {
    await delay(1000);
    return {
      themes: mockQuizData.themes,
      questions: mockQuizData.questions,
    };
  }
};

